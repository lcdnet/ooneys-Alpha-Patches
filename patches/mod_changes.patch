+                    }
+                    break;
+                }
+            }
+        }
+
+
+
+        // Play the actual record sound (still 13.ogg / cat.ogg)
+        world.playRecord(recordName, x, y, z, overlayText);
+
+
+    // Show overlay (label comes from sign if present)
+        if (!world.multiplayerWorld) {
+            if (mc != null && mc.ingameGUI != null) {
